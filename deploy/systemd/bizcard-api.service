[Unit]
Description=BizCard API (FastAPI)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=bizcard
Group=bizcard
WorkingDirectory=/opt/bizcard/app/backend
EnvironmentFile=/opt/bizcard/shared/backend.env
ExecStart=/opt/bizcard/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
